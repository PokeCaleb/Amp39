<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <!-- Top bar: down arrow + 3-dot menu -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_keyboard_arrow_down"
        app:navigationIconTint="@color/md_theme_primary"
        app:menu="@menu/menu_player"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- "Now Playing" label -->
    <TextView
        android:id="@+id/tvNowPlayingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reproduciendo"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:letterSpacing="0.12"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Album art — large square -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAlbumArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_default_album_art"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MikuPlayer.AlbumArt"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@id/tvSongTitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Preview de la carátula siguiente/anterior, usada durante el gesto de
         swipe: se superpone exactamente sobre ivAlbumArt (mismas restricciones)
         y entra desde arriba/abajo siguiendo el dedo del usuario. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAlbumArtPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MikuPlayer.AlbumArt"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintBottom_toTopOf="@id/tvSongTitle" />

    <!-- Song title -->
    <TextView
        android:id="@+id/tvSongTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="20dp"
        android:text="Título de la canción"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
        android:textColor="@color/md_theme_onSurface"
        android:maxLines="1"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ivAlbumArt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvArtist" />

    <!-- Artist -->
    <TextView
        android:id="@+id/tvArtist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="4dp"
        android:text="Artista"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        android:textColor="@color/md_theme_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvSongTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnFavoritePlayer" />


    <!-- Favorite button -->
    <ImageButton
        android:id="@+id/btnFavoritePlayer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_heart_outline"
        android:padding="8dp"
        android:contentDescription="Favorito"
        app:layout_constraintTop_toBottomOf="@id/tvArtist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/seekBar" />

    <!-- SeekBar -->
    <com.google.android.material.slider.Slider
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:valueFrom="0"
        android:valueTo="100"
        android:value="0"
        app:thumbColor="@color/md_theme_primary"
        app:trackColorActive="@color/md_theme_primary"
        app:trackColorInactive="@color/md_theme_surfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/btnFavoritePlayer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvCurrentTime" />

    <!-- Time row -->
    <TextView
        android:id="@+id/tvCurrentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:text="0:00"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/md_theme_onSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llControls" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="28dp"
        android:text="0:00"
        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        android:textColor="@color/md_theme_onSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/llControls" />

    <!-- Controls row: shuffle | prev | play/pause | next | repeat -->
    <LinearLayout
        android:id="@+id/llControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentTime"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Shuffle -->
        <ImageButton
            android:id="@+id/btnShuffle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/md_theme_onSurfaceVariant"
            android:contentDescription="Aleatorio" />

        <!-- Previous -->
        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/md_theme_onSurface"
            android:contentDescription="Anterior" />

        <!-- Play/Pause — big teal circle -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp">
            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_icon_circle_primary"
                android:src="@drawable/ic_play"
                android:tint="@color/md_theme_onPrimary"
                android:padding="16dp"
                android:contentDescription="@string/play_pause" />
        </FrameLayout>

        <!-- Next -->
        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/md_theme_onSurface"
            android:contentDescription="@string/next" />

        <!-- Repeat -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_repeat"
                android:tint="@color/md_theme_onSurfaceVariant"
                android:contentDescription="Repetir" />

            <!-- FIX: distingue REPEAT_MODE_ONE de REPEAT_MODE_ALL, antes se veían
                 idénticos (solo cambiaba el alpha del mismo ícono para ambos). -->
            <TextView
                android:id="@+id/tvRepeatOneBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_repeat_one_badge"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="1"
                android:textColor="@color/md_theme_onPrimary"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:importantForAccessibility="no" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
